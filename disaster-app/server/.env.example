PORT=4000
JWT_SECRET=change-me-in-production-disaster-app-dev-secret
CLIENT_ORIGIN=http://localhost:5173

# Optional. TomTom Traffic API key, used for live incidents, traffic-aware
# routing and the traffic flow tile layer. The key is read only on the server
# and is never sent to the browser: tiles are proxied through /api/traffic.
# Leave this blank to run with OSRM routing and a clearly labelled simulated
# traffic layer instead. Get a free key at https://developer.tomtom.com
TOMTOM_API_KEY=

# Flow tile colouring. "relative" shades roads by how far below free-flow
# speed they are, "absolute" shades by raw speed. Falls back automatically if
# the chosen style is rejected.
TOMTOM_FLOW_STYLE=relative
